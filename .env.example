# ==========================================================
# EMA - variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs.
# NE JAMAIS committer le fichier .env.
# ==========================================================

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
# Modèle utilisé par l'agent (défaut : claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# --- Microsoft Graph / Outlook (OAuth, jamais de mot de passe) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback

# --- WhatsApp Business Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Secret de l'app Meta : vérification de la signature X-Hub-Signature-256 des webhooks (obligatoire en production)
WHATSAPP_APP_SECRET=
# Numéro autorisé à valider les actions (format international, ex. 33612345678). Seul ce numéro peut valider.
# Numéro WhatsApp Business d'EMA (E.164), affiché aux utilisateurs pour le lien « Ouvrir WhatsApp »
WHATSAPP_BUSINESS_NUMBER=
# Obsolète : chaque utilisateur est identifié par le numéro vérifié de son compte (Paramètres → Connexions)
WHATSAPP_APPROVER_PHONE=
# Version de l'API Graph Meta
WHATSAPP_API_VERSION=v21.0
# Assistant conversationnel WhatsApp (phase 6). false = seules les validations restent actives.
WHATSAPP_ASSISTANT_ENABLED=true
# Template Meta approuvé pour les notifications proactives hors fenêtre de 24 h (phase 7). Vide = notification différée.
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_LANG=fr

# --- Application ---
# URL publique de l'instance. En production, HTTPS est OBLIGATOIRE :
# EMA refuse de démarrer avec une URL en http:// (NODE_ENV=production).
APP_URL=http://localhost:3000
# Secret aléatoire (>= 32 caractères) : chiffrement des tokens + sessions UI
# Générer avec : openssl rand -hex 32
APP_SECRET=
# Obsolète : l'accès se fait par compte utilisateur (email + mot de passe), créé depuis /login
APP_PASSWORD=
# true pour autoriser la création de nouveaux comptes après le premier (un compte par dirigeant)
ALLOW_SIGNUP=false

# --- Stockage local (tout reste sur le VPS) ---
DATABASE_PATH=./data/ema.db
PRIVATE_STORAGE_PATH=./private
CONFIG_PATH=./config

# --- Worker / synchronisation Outlook ---
# Intervalle de scan de la boîte Outlook (secondes)
WORKER_POLL_INTERVAL=120
# Nombre maximal d'emails ingérés par passage (mode test : 20)
EMAIL_SYNC_LIMIT=50
# À la première synchronisation, ne remonter que les N derniers jours (0 = tout)
EMAIL_INITIAL_SYNC_DAYS=7
# Taille maximale d'une pièce jointe téléchargée (Mo)
ATTACHMENT_MAX_MB=15
# Pièces jointes sortantes (base64 dans la requête Graph) : au-delà, envoi manuel demandé
OUTGOING_ATTACHMENT_MAX_MB=3
# Extraction PDF : le worker d'extraction est arrêté au-delà de ce délai
PDF_EXTRACTION_TIMEOUT_SECONDS=20
# Chiffrement des sauvegardes (AES-256-GCM). Vide = sauvegarde en clair, refusée en production.
# À conserver hors du VPS : sans ce mot de passe, une sauvegarde chiffrée est définitivement illisible.
BACKUP_ENCRYPTION_PASSWORD=
# --- POC Composio (Outlook via Composio, lecture seule) — test technique, désactivé par défaut ---
COMPOSIO_POC_ENABLED=false
# Clé API Composio : serveur uniquement (jamais dans Git, le frontend, les journaux ou les tests)
COMPOSIO_API_KEY=
# Identifiant de l'auth config Outlook (tableau de bord Composio). Facultatif si une seule auth config Outlook existe.
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
# Callback Identity Verification (verifier URL = APP_URL/api/poc/composio/callback dans Composio → Settings → General).
# Obligatoire en production ; false = callback classique, toléré uniquement en développement (lien à garder privé).
COMPOSIO_CALLBACK_VERIFICATION=false
# true seulement si Nginx réécrit X-Forwarded-For (limitation de connexion par IP)
TRUST_PROXY_HEADER=false
# Niveau de logs : debug | info | warn | error
LOG_LEVEL=info
