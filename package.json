{
  "name": "ema",
  "version": "1.0.0",
  "private": true,
  "description": "EMA - Agent administratif IA pour une boîte Outlook professionnelle (instance privée, déployée sur VPS)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:status": "tsx src/database/cli.ts status",
    "worker": "tsx src/worker/index.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.25",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
